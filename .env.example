# Environment variables are read from the process; this file is a reference.
# The server does not automatically load .env files.
HOST=127.0.0.1
PORT=3000
# LIBERTTY_CWD=/path/to/project
# Pairing is required on every host, including localhost. When unset or empty,
# a token is generated, saved in LIBERTTY_DATA_DIR/pairing-token, and printed at startup.
# LIBERTTY_TOKEN=at-least-24-random-characters
# LIBERTTY_DATA_DIR=/path/to/libertty-data
# LIBERTTY_ALLOWED_HOSTS=libertty.example.com

# LIBERTTY_BASE_PATH=/t
# Ctrl-R/Readline: ~/.bash_eternal_history, falling back to ~/.bash_history.
# Suggestions also merge ~/.bash_history and Bash's configured HISTFILE.
# LIBERTTY_HISTORY_FILE=/path/to/history
# LIBERTTY_ETERNAL_HISTORY_FILE=/path/to/eternal-history
