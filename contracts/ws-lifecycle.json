{
  "version": 1,
  "reference": "455386bc9443e778f381e1eeaf37cec5a35c2f75",
  "terminal": {
    "states": [
      "detached",
      "attached",
      "paused",
      "disposed"
    ],
    "shellStates": [
      "starting",
      "ready",
      "busy",
      "exited"
    ],
    "authentication": {
      "host": "allowlist",
      "origin": "same-origin-or-allowlist",
      "owner": "paired-client",
      "session": "owned-live-non-file-session",
      "ticket": {
        "bytes": 32,
        "encoding": "hex",
        "ttlMs": 15000,
        "maxPending": 256,
        "singleUse": true,
        "scope": [
          "owner",
          "session"
        ]
      }
    },
    "encodings": {
      "text": "UTF-8 JSON",
      "binary": "framed Opus dictation audio"
    },
    "unknownTag": "ignore",
    "malformedJSON": {
      "action": "close",
      "code": 1008,
      "reason": "Invalid message"
    },
    "transitions": [
      {
        "from": [
          "detached",
          "attached",
          "paused"
        ],
        "event": "upgrade",
        "to": "attached",
        "actions": [
          "cancel-dictation",
          "cancel-expiry",
          "replace-current-socket",
          "reset-ack-window",
          "send-hello",
          "send-input-ack",
          "send-state",
          "replay-output",
          "replay-captures-and-transfers",
          "push-context"
        ]
      },
      {
        "from": [
          "attached",
          "paused"
        ],
        "event": "replacement-attachment",
        "oldSocket": {
          "code": 4001,
          "reason": "This shell was opened in another tab."
        },
        "inputAuthority": "newest-socket-only"
      },
      {
        "from": [
          "attached"
        ],
        "event": "output-window-full",
        "to": "paused",
        "actions": [
          "pause-PTY"
        ]
      },
      {
        "from": [
          "paused"
        ],
        "event": "acknowledged-window-drained",
        "to": "attached",
        "actions": [
          "flush-output",
          "resume-PTY"
        ]
      },
      {
        "from": [
          "attached",
          "paused"
        ],
        "event": "current-socket-close",
        "to": "detached",
        "actions": [
          "cancel-dictation",
          "stop-context-push",
          "clear-ack-window",
          "resume-PTY",
          "start-expiry"
        ]
      },
      {
        "from": [
          "detached",
          "attached",
          "paused"
        ],
        "event": "PTY-exit",
        "preserveState": true,
        "shellState": "exited",
        "actions": [
          "send-state"
        ]
      },
      {
        "from": [
          "detached",
          "attached",
          "paused"
        ],
        "event": "expiry-or-shutdown",
        "to": "disposed",
        "actions": [
          "dispose-PTY",
          "cancel-jobs",
          "remove-temporary-captures"
        ]
      }
    ],
    "stream": {
      "sequence": "monotonic-per-stream",
      "after": "nonnegative-safe-integer",
      "gap": [
        "requested-stream-differs",
        "after-exceeds-last-sequence",
        "positive-after-precedes-first-sequence-minus-one"
      ],
      "helloBeforeReplay": true,
      "reset": [
        "after-is-zero",
        "gap"
      ],
      "replayMaxBytes": 2097152,
      "replayMaxChunks": 16384,
      "retainAtLeastOneChunk": true,
      "windowBytes": 131072,
      "sendWhile": "outstanding-bytes-less-than-window",
      "allowOneChunkOvershoot": true,
      "acknowledgement": "safe-integer-not-greater-than-last-sent-sequence"
    },
    "command": {
      "require": [
        "ready",
        "not-exited",
        "no-capture",
        "matching-prompt"
      ],
      "maxUTF16": 4000,
      "forbidControls": true,
      "deduplication": "command-ID",
      "maxCachedResults": 1000,
      "editsThenSubmits": true
    },
    "replace": {
      "require": [
        "ready",
        "not-exited",
        "no-capture",
        "matching-prompt",
        "matching-input-revision"
      ],
      "maxUTF16": 4000,
      "forbidControls": true,
      "submits": false
    },
    "repair": {
      "require": [
        "ready",
        "not-exited",
        "no-capture",
        "matching-prompt",
        "matching-input-revision",
        "matching-attachment",
        "not-cancelled"
      ],
      "maxUTF16": 2000,
      "timeoutMs": 10000,
      "submits": false,
      "result": "repair-result",
      "cancellation": "repair-cancel",
      "readingIntent": "explicit"
    },
    "input": {
      "maxUTF16": 65536,
      "require": [
        "not-exited",
        "no-capture"
      ],
      "incrementsInputRevision": true
    },
    "inputLine": {
      "timeoutMs": 2000,
      "require": [
        "ready",
        "not-exited",
        "no-capture",
        "no-pending-input-line",
        "matching-prompt",
        "matching-input-revision"
      ],
      "cursorEncoding": "UTF-16-prefix-length"
    },
    "resize": {
      "type": "integer",
      "clamp": {
        "cols": [
          2,
          300
        ],
        "rows": [
          2,
          120
        ]
      }
    },
    "expiryMs": 3600000
  },
  "herdr": {
    "authentication": {
      "host": "allowlist",
      "origin": "same-origin-or-allowlist",
      "owner": "paired-client",
      "session": "owned-source-and-terminal",
      "ticketTTLms": 15000,
      "ticketSingleUse": true
    },
    "maxConnections": 64,
    "encodings": {
      "text": "UTF-8 JSON",
      "frameBytes": "base64"
    },
    "resize": {
      "type": "integer",
      "cols": [
        1,
        1000
      ],
      "rows": [
        1,
        1000
      ],
      "authority": "latest-mobile-controller"
    },
    "repaint": "request-full-frame-after-incremental-frame-gap",
    "dispose": [
      "close-streams",
      "cancel-dictation",
      "remove-notification-presence",
      "unsubscribe-source"
    ]
  }
}
