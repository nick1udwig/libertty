{
  "name": "termai",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "migration:schemas": "node scripts/migration-schemas.mjs",
    "migration:inventory": "node scripts/migration-inventory.mjs",
    "migration:fixtures": "node scripts/migration-fixtures.mjs",
    "migration:state-fixtures": "node scripts/migration-state-fixtures.mjs",
    "migration:host-fixtures": "node scripts/migration-host-fixtures.mjs",
    "migration:async-fixtures": "node scripts/migration-async-fixtures.mjs",
    "migration:prewarm-fixtures": "node scripts/migration-prewarm-fixtures.mjs",
    "migration:herdr-fixtures": "node scripts/migration-herdr-fixtures.mjs",
    "migration:key-fixtures": "node scripts/migration-key-fixtures.mjs",
    "migration:vocabulary": "node scripts/migration-vocabulary.mjs",
    "migration:lexical-fixtures": "node scripts/migration-lexical-fixtures.mjs",
    "build:rust-engine": "node scripts/build-rust-engine.mjs",
    "build:backend": "cargo build --locked -p termai-server --bin termai",
    "test:rust": "cargo test --workspace --locked",
    "test:rust-browser": "node test/rust-engine-browser.mjs",
    "test:contracts": "node --test test/migration-contracts.test.mjs",
    "test:rust-state": "node test/rust-state-compat.mjs",
    "test:rust-herdr": "node test/rust-herdr.mjs",
    "postinstall": "node scripts/prepare-dependencies.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:reference": "node server/index.ts",
    "build": "npm run build:backend && npm run build:rust-engine && tsc --noEmit && vite build",
    "start": "cargo run --release --locked -p termai-server --bin termai",
    "start:reference": "NODE_ENV=production node server/index.ts",
    "test": "node --test test/*.test.ts test/dependencies.test.mjs test/migration-contracts.test.mjs",
    "test:browser": "node test/browser.mjs",
    "test:reconnect": "node test/reconnect-browser.mjs",
    "test:gestures": "node test/terminal-gestures-browser.mjs",
    "test:touch": "node test/terminal-touch-browser.mjs",
    "test:reading": "node test/reading-browser.mjs",
    "test:files": "node test/files-browser.mjs",
    "bench:architecture": "node test/architecture-benchmark.ts",
    "test:workspace": "node test/workspace-browser.mjs",
    "test:herdr": "node test/herdr-browser.mjs",
    "test:herdr-resize": "node test/herdr-resize-native.mjs",
    "test:herdr-scroll": "node test/herdr-app-scroll-native.mjs",
    "test:herdr-spaces": "node test/herdr-spaces-browser.mjs",
    "test:pairing": "node test/pairing-browser.mjs",
    "test:plugins": "node test/plugins-browser.mjs",
    "release:package": "node scripts/package-release.mjs",
    "test:install": "node --test test/install.test.mjs test/setup-integrations.test.mjs"
  },
  "dependencies": {
    "ghostty-web": "0.4.0-next.20.g1858a59",
    "libopus-wasm": "0.4.1",
    "markdown-it": "^15.0.2",
    "node-pty": "1.1.0",
    "ssh2": "1.17.0",
    "web-push": "^3.6.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "26.6.1",
    "@types/ssh2": "^1.15.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.1",
    "ajv": "8.20.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "typescript-reference": "npm:typescript@5.9.3",
    "vite": "8.3.0"
  }
}
