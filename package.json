{
  "name": "libertty",
  "version": "0.2.11",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "ci:quick": "node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/ci-quick.mjs",
    "build:backend": "cargo build --locked -p libertty-server --bin libertty",
    "test:rust": "cargo test --workspace --locked",
    "bindings": "LIBERTTY_WRITE_BINDINGS=1 cargo test --locked -p libertty-server --lib typescript_bindings",
    "test:rust-herdr": "node test/rust-herdr.mjs",
    "postinstall": "node scripts/prepare-dependencies.mjs",
    "dev": "node scripts/dev.mjs",
    "build:frontend": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && vite build --config site/vite.config.ts",
    "dev:site": "vite --config site/vite.config.ts",
    "test:site": "npm run build:site && node test/site-browser.mjs",
    "bench:site": "npm run build:site && node test/site-performance.mjs",
    "build": "npm run build:backend && npm run build:frontend",
    "build:release": "cargo build --release --locked -p libertty-server --bin libertty && npm run build:frontend",
    "start": "cargo run --release --locked -p libertty-server --bin libertty",
    "test": "node --test test/*.test.ts test/dependencies.test.mjs test/package-release.test.mjs test/publish-release.test.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:browser": "node scripts/check-browser.mjs",
    "verify:performance": "node scripts/check-performance.mjs",
    "verify:package": "node scripts/check-package.mjs",
    "test:browser": "node test/browser.mjs",
    "test:reconnect": "node test/reconnect-browser.mjs",
    "test:herdr-reopen": "node test/herdr-reopen-browser.mjs",
    "test:gestures": "node test/terminal-gestures-browser.mjs",
    "test:touch": "node test/terminal-touch-browser.mjs",
    "test:reading": "node test/reading-browser.mjs",
    "test:files": "node test/files-browser.mjs",
    "bench:architecture": "node test/architecture-benchmark.ts",
    "bench:workspace": "node test/workspace-benchmark.mjs",
    "test:workspace": "node test/workspace-browser.mjs",
    "test:herdr": "node test/herdr-browser.mjs",
    "test:herdr-dictation": "node test/herdr-dictation-browser.mjs",
    "test:herdr-resize": "node test/herdr-resize-native.mjs",
    "test:herdr-scroll": "node test/herdr-app-scroll-native.mjs",
    "test:herdr-spaces": "node test/herdr-spaces-browser.mjs",
    "test:pairing": "node test/pairing-browser.mjs",
    "test:plugins": "node test/plugins-browser.mjs",
    "release:package": "node scripts/package-release.mjs",
    "test:install": "node --test test/install.test.mjs test/setup-integrations.test.mjs",
    "test:herdr-flash": "node test/herdr-space-flash-native.mjs",
    "test:herdr-loading": "node test/herdr-loading-browser.mjs",
    "build:test-support": "cargo build --locked -p libertty-server --examples",
    "pretest": "npm run build:test-support",
    "contracts:vocabulary": "node scripts/engine-vocabulary.mjs",
    "format:workspace": "prettier --write src/main.ts src/workspace-*.ts",
    "check:workspace-format": "prettier --check src/main.ts src/workspace-*.ts"
  },
  "dependencies": {
    "ghostty-web": "0.4.0-next.20.g1858a59",
    "libopus-wasm": "0.4.1",
    "markdown-it": "^15.0.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "26.6.1",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "8.18.1",
    "ajv": "8.20.0",
    "node-pty": "1.1.0",
    "playwright-core": "1.63.0",
    "prettier": "3.6.2",
    "ssh2": "1.17.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
