{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noEmit": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "esModuleInterop": true, "verbatimModuleSyntax": true
  },
  "include": ["src", "site", "test/**/*.ts", "vite.config.ts"]
}
